# ==============================================================================
# ORIVANTA PIM — ROOT ENVIRONMENT TEMPLATE
# Copy this file to .env (or backend/.env) for local development.
# Never commit real secrets or credentials to source control.
# ==============================================================================

NODE_ENV=development
PORT=5000

# SQLite local persistence
DATABASE_PATH=./data/orivanta.sqlite
SESSION_SECRET=dev_session_secret_replace_in_production_with_64_random_chars
COOKIE_SECURE=false

# WooCommerce Store Integration
# Set INTEGRATION_MODE to 'mock' for local offline zero-dependency development.
# Set INTEGRATION_MODE to 'woocommerce' to connect a live WooCommerce store.
INTEGRATION_MODE=mock
WOOCOMMERCE_STORE_URL=https://your-store.example.com
WOOCOMMERCE_CONSUMER_KEY=ck_your_consumer_key_here
WOOCOMMERCE_CONSUMER_SECRET=cs_your_consumer_secret_here

# Gemini-Powered Agentic AI (Server-side only — never expose to frontend)
# Set AI_ENABLED=true and provide GEMINI_API_KEY to enable live Gemini reasoning.
# If AI_ENABLED=false or GEMINI_API_KEY is empty, core PIM runs 100% and uses offline MockGeminiProvider.
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_MAX_TOOL_STEPS=6
AI_REQUEST_TIMEOUT_MS=30000

# Frontend API Endpoint (Used by Vite dev server)
VITE_API_BASE_URL=http://localhost:5000/api
