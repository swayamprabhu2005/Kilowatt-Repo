NODE_ENV=development
PORT=5000

# SQLite Persistence
DATABASE_PATH=../data/orivanta.sqlite
SESSION_SECRET=dev_session_secret_for_local_testing_only_32_characters_minimum
JWT_SECRET=dev_jwt_secret_key_for_optional_stateless_tokens_32_characters_minimum
COOKIE_SECURE=false

# WooCommerce Store Integration
INTEGRATION_MODE=mock
WOOCOMMERCE_STORE_URL=https://mock.orivanta.local
WOOCOMMERCE_CONSUMER_KEY=ck_mock_key
WOOCOMMERCE_CONSUMER_SECRET=cs_mock_secret

# Gemini-Powered Agentic AI
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_MAX_TOOL_STEPS=6
AI_REQUEST_TIMEOUT_MS=30000
